{
    "name": "build-gradle-reader",
    "version": "2.0.0",
    "type": "module",
    "main": "./lib/parse.js",
    "types": "./lib/parse.d.ts",
    "exports": {
        ".": {
            "import": "./lib/parse.js",
            "types": "./lib/parse.d.ts"
        }
    },
    "description": "Converts build.gradle files into js representations",
    "keywords": [
        "build.gradle",
        "gradle",
        "android"
    ],
    "homepage": "https://github.com/ehoogerbeets/build-gradle-reader",
    "bugs": "https://github.com/ehoogerbeets/build-gradle-reader/issues",
    "email": "contact@healthtap.com",
    "license": "Apache-2.0",
    "author": {
        "name": "Edwin Hoogerbeets",
        "web": "http://www.healthtap.com/",
        "email": "edwin.hoogerbeets@healthtap.com"
    },
    "contributors": [
        {
            "name": "Edwin Hoogerbeets",
            "email": "ehoogerbeets@healthtap.com"
        }
    ],
    "files": [
        "bin",
        "lib",
        "README.md",
        "LICENSE.txt"
    ],
    "repository": {
        "type": "git",
        "url": "git@github.com:ehoogerbeets/build-gradle-reader.git"
    },
    "engines": {
        "nodejs": ">=12 <23"
    },
    "scripts": {
        "build": "tsc",
        "build:watch": "tsc --watch",
        "prepublishOnly": "npm run build",
        "pretest": "npm run build",
        "test": "LANG=en_US.UTF8 node --experimental-vm-modules node_modules/jest/bin/jest.js",
        "test:watch": "npm run build && LANG=en_US.UTF8 node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
        "test:coverage": "npm run build && LANG=en_US.UTF8 node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
        "debug": "npm run build && LANG=en_US.UTF8 node --experimental-vm-modules node_modules/jest/bin/jest.js --debug",
        "clean": "rm -rf lib",
        "clean:all": "git clean -f -d src test lib"
    },
    "directories": {
        "test": "test",
        "lib": "lib"
    },
    "devDependencies": {
        "@types/node": "^22.0.0",
        "jest": "^30.2.0",
        "typescript": "^5.0.0"
    },
    "dependencies": {
        "deep-assign": "2.0.0"
    },
    "bin": "./bin/build-gradle-reader"
}
